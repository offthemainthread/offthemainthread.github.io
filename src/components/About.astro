---
import { profile, experience } from "../data/site";
const current = experience[0];
---
<section id="about" class="section">
  <div class="container">
    <div class="about-grid">
      <div class="about-head reveal">
        <p class="eyebrow">About</p>
        <h2 class="section-title">Background</h2>
      </div>
      <div class="about-body reveal">
        {profile.about.map((p) => <p>{p}</p>)}
        <dl class="about-facts">
          <div><dt>Based in</dt><dd>{profile.location}</dd></div>
          <div><dt>Focus</dt><dd>Backend · Distributed systems · Platform</dd></div>
          <div><dt>Currently</dt><dd>{current.role} @ {current.company}</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>
<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  .about-head { position: sticky; top: 90px; }
  .about-body p { color: var(--text-muted); margin-bottom: 1.1rem; max-width: 62ch; }
  .about-facts {
    margin-top: 1.8rem;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .about-facts > div {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.85rem 1.1rem; background: var(--surface); flex-wrap: wrap;
  }
  .about-facts dt { color: var(--text-faint); font-size: 0.85rem; font-family: var(--font-mono); }
  .about-facts dd { color: var(--text); font-weight: 520; font-size: 0.92rem; text-align: right; }
  @media (max-width: 760px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-head { position: static; }
  }
</style>
