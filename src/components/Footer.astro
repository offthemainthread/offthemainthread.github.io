---
import { profile } from "../data/site";
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p class="foot-name">{profile.name}</p>
    <div class="foot-links">
      <a href="/cv">CV</a>
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={profile.socials.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2.25rem;
    background: var(--bg-subtle);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .foot-name { font-weight: 600; }
  .foot-meta { color: var(--text-faint); font-size: 0.88rem; }
  .foot-links { display: flex; gap: 1.1rem; }
  .foot-links a { color: var(--text-muted); font-size: 0.9rem; }
  .foot-links a:hover { color: var(--accent); }
  @media (max-width: 560px) { .footer-inner { justify-content: flex-start; } }
</style>
