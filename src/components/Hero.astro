---
import { profile } from "../data/site";
---
<section id="top" class="hero">
  <div class="container hero-inner">
    <p class="status reveal">
      <span class="status-dot" aria-hidden="true"></span>
      {profile.status}
    </p>

    <h1 class="hero-title reveal">{profile.name}</h1>
    <p class="hero-role reveal">{profile.role} · Backend &amp; distributed systems</p>

    <p class="hero-sub reveal">{profile.intro}</p>

    <div class="hero-cta reveal">
      <a href="#experience" class="btn btn-primary">View experience</a>
      <a href={`mailto:${profile.email}`} class="btn btn-ghost">Email me</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3.5rem, 9vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero-inner { max-width: 640px; }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--secondary);
    flex: none;
  }

  .hero-title {
    font-size: clamp(2.1rem, 6vw, 3.1rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  .hero-role {
    color: var(--text-muted);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    font-weight: 480;
    margin-bottom: 1.6rem;
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 56ch;
    margin-bottom: 2rem;
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .hero-inner .reveal:nth-child(1) { transition-delay: 0.02s; }
  .hero-inner .reveal:nth-child(2) { transition-delay: 0.07s; }
  .hero-inner .reveal:nth-child(3) { transition-delay: 0.12s; }
  .hero-inner .reveal:nth-child(4) { transition-delay: 0.17s; }
  .hero-inner .reveal:nth-child(5) { transition-delay: 0.22s; }
</style>
