---
import Base from "../layouts/Base.astro";
import { profile, experience, education, skillGroups } from "../data/site";

const title = `${profile.name} · CV`;
const description = `Curriculum vitae of ${profile.name}, ${profile.role}. Download the PDF or read it online.`;
---

<Base title={title} description={description}>
  <section class="section cv-page">
    <div class="container cv-wrap">
      <header class="cv-head reveal">
        <p class="eyebrow">Résumé / CV</p>
        <h1 class="cv-name">{profile.name}</h1>
        <p class="cv-role">{profile.role}</p>
        <p class="cv-contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <span aria-hidden="true">·</span>
          <span>{profile.location}</span>
          <span aria-hidden="true">·</span>
          <a href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </p>
        <div class="cv-actions">
          <a href={profile.resumeFile} download class="btn btn-primary">↓ Download PDF</a>
          <a href={profile.resumeFile} target="_blank" rel="noopener" class="btn btn-ghost">Open in new tab</a>
          <a href="/" class="btn btn-ghost">Back to site</a>
        </div>
        <p class="cv-updated">Last updated {profile.resumeUpdated}</p>
      </header>

      <div class="cv-body">
        <section class="cv-block reveal" aria-labelledby="cv-exp">
          <h2 id="cv-exp" class="cv-h2">Experience</h2>
          {experience.map((job) => (
            <article class="cv-entry">
              <div class="cv-entry-top">
                <h3 class="cv-entry-title">{job.role} <span class="cv-at">·</span> {job.company}</h3>
                <span class="cv-period">{job.period}</span>
              </div>
              <p class="cv-entry-meta">{job.location}</p>
              <ul class="cv-points">
                {job.highlights.map((h) => <li>{h}</li>)}
              </ul>
              <ul class="cv-tags" aria-label="Technologies and concepts">
                {job.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </article>
          ))}
        </section>

        <section class="cv-block reveal" aria-labelledby="cv-edu">
          <h2 id="cv-edu" class="cv-h2">Education</h2>
          {education.map((ed) => (
            <article class="cv-entry">
              <div class="cv-entry-top">
                <h3 class="cv-entry-title">{ed.degree}</h3>
                <span class="cv-period">{ed.period}</span>
              </div>
              <p class="cv-entry-meta">{ed.school} <span class="cv-at">·</span> {ed.location}</p>
            </article>
          ))}
        </section>

        <section class="cv-block reveal" aria-labelledby="cv-skills">
          <h2 id="cv-skills" class="cv-h2">Skills</h2>
          <dl class="cv-skills">
            {skillGroups.map((g) => (
              <div class="cv-skill-row">
                <dt class="cv-skill-label">{g.label}</dt>
                <dd class="cv-skill-items">{g.items.join(" · ")}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .cv-wrap { max-width: 780px; }

  .cv-head { margin-bottom: 2.75rem; }
  .cv-name {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.35rem;
  }
  .cv-role { color: var(--text-muted); font-size: 1.1rem; margin-bottom: 0.9rem; }
  .cv-contact {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem;
    font-family: var(--font-mono); font-size: 0.82rem;
    color: var(--text-faint); margin-bottom: 1.6rem;
  }
  .cv-contact a { color: var(--text-muted); }
  .cv-contact a:hover { color: var(--accent); }

  .cv-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .cv-updated {
    margin-top: 1rem; font-size: 0.8rem; color: var(--text-faint);
  }

  .cv-block { margin-bottom: 2.75rem; }
  .cv-block:last-child { margin-bottom: 0; }
  .cv-h2 {
    font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--secondary); font-weight: 700;
    padding-bottom: 0.6rem; margin-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }

  .cv-entry { margin-bottom: 1.6rem; }
  .cv-entry:last-child { margin-bottom: 0; }
  .cv-entry-top {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 0.75rem 1.25rem; flex-wrap: wrap;
  }
  .cv-entry-title { font-size: 1.05rem; }
  .cv-at { color: var(--text-faint); font-weight: 400; }
  .cv-period {
    font-family: var(--font-mono); font-size: 0.76rem; color: var(--secondary);
    background: var(--secondary-soft); padding: 0.25rem 0.6rem; border-radius: 999px;
    white-space: nowrap;
  }
  .cv-entry-meta {
    color: var(--text-muted); font-size: 0.9rem; margin-top: 0.2rem;
  }
  .cv-points {
    margin: 0.8rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.5rem;
  }
  .cv-points li { color: var(--text-muted); font-size: 0.93rem; line-height: 1.55; }
  .cv-points li::marker { color: var(--secondary); }
  .cv-tags { list-style: none; margin: 0.9rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .cv-skills { margin: 0; display: grid; gap: 0.9rem; }
  .cv-skill-row {
    display: grid; grid-template-columns: 170px 1fr; gap: 0.5rem 1.25rem; align-items: baseline;
  }
  .cv-skill-label { font-weight: 600; font-size: 0.9rem; }
  .cv-skill-items { color: var(--text-muted); font-size: 0.9rem; margin: 0; }

  @media (max-width: 560px) {
    .cv-skill-row { grid-template-columns: 1fr; gap: 0.15rem; }
    .cv-skill-label { color: var(--text); }
  }
</style>
